{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dsh-preference-sync",
  "description": "Allow the bundled loopback DSH UI to synchronize native OpenHarness chrome and its Status Bar session summary.",
  "local": false,
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://127.0.0.1:*",
      "http://[\\:\\:1]:*",
      "http://localhost:*"
    ]
  },
  "permissions": ["allow-sync-dsh-preferences", "allow-sync-dsh-sessions"]
}
