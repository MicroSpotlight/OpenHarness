{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenHarness",
  "version": "0.1.0",
  "identifier": "team.MicroSpotlight.OpenHarness",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Native AI desktop app for macOS",
    "longDescription": "OpenHarness runs an open-source AI agent harness in a native macOS window.",
    "copyright": "Copyright 2026 MicroSpotlight",
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "15.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "runtime/": "runtime/",
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE"
    }
  }
}
