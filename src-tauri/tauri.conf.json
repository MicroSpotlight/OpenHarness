{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenHarness",
  "version": "0.1.1",
  "identifier": "team.MicroSpotlight.OpenHarness",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Native AI agent desktop app",
    "longDescription": "OpenHarness runs an open-source AI agent harness in a native desktop window.",
    "copyright": "Copyright 2026 MicroSpotlight",
    "macOS": {
      "bundleVersion": "7",
      "hardenedRuntime": true,
      "minimumSystemVersion": "15.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "runtime/": "runtime/",
      "target/generated/Credits.html": "Credits.html",
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBOUQ1OEZBMzZCQzM5QTMKUldTak9idzIrbGlkR3NMMU1lNFkybWl5dDZVWjdQUzZ0UGxrazBCUkFVNytMY2syQWU0MzlnTXcK",
      "endpoints": [
        "https://openharness.microspotlight.team/latest.json"
      ]
    }
  }
}
